# Weekly digest secrets — copy to `mysecrets` and fill in.
#   cp mysecrets.example mysecrets && chmod 600 mysecrets
# run.sh sources this file, so every line must be a valid shell `export`.
# Never commit the real `mysecrets` file.

# --- OpenRouter (summarization via Claude) ---
export OPENROUTER_API_KEY="sk-or-..."
# Two valid forms on OpenRouter:
#   - Auto-latest alias (note the leading ~): ~anthropic/claude-sonnet-latest
#       tracks the newest Sonnet automatically (currently 4.6).
#   - Pinned version (reproducible): anthropic/claude-sonnet-4.6 (or 4.5, 4).
# Pinning avoids surprise model/cost changes in an unattended cron job.
export OPENROUTER_MODEL="~anthropic/claude-sonnet-latest"

# --- Gmail API (read-only OAuth) ---
# Get these by running:  python gmail_auth.py /path/to/client_secret.json
export GMAIL_CLIENT_ID="....apps.googleusercontent.com"
export GMAIL_CLIENT_SECRET="GOCSPX-..."
export GMAIL_REFRESH_TOKEN="1//..."
# Gmail label to compile (display name, with the space):
export GMAIL_LABEL="News Letter"

# --- Reeder shared feed (the .json suffix is required) ---
export REEDER_FEED_URL="https://reederapp.net/<your-feed-id>.json"

# --- Output / metadata ---
export DIGEST_OUTPUT_DIR="$HOME/Desktop"
export DIGEST_COMPILED_FOR="Your Name"

# --- Optional: override the coverage week (default = previous Mon..Sun) ---
# export DIGEST_WEEK_START="2026-05-11"
# export DIGEST_WEEK_END="2026-05-17"
